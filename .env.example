# Docker Compose 示例配置。密码文件只保存在本机，不提交到 GitHub。
FYT_ADMIN_PASSWORD_FILE=./secrets/admin-password.txt
# 默认从 AWS Public ECR 获取 Docker 官方基础镜像；网络允许时也可改回 node:22-bookworm-slim
# 与 python:3.13-slim-bookworm，或填写组织内部镜像仓库地址。
FYT_DOCKER_NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
FYT_DOCKER_PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.13-slim-bookworm
FYT_DOCKER_NPM_REGISTRY=https://registry.npmmirror.com
FYT_DOCKER_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
FYT_WEB_BIND=127.0.0.1
FYT_WEB_BIND_PORT=8787
# 默认使用 Docker 命名卷；如需宿主机目录备份，可改为 /srv/fyt-data（Linux）或绝对 Windows 路径。
FYT_DATA_DIR=fyt-data
FYT_BUSINESS_TZ_OFFSET=8
FYT_OUTPUT_RETENTION_COUNT=20
FYT_TRASH_RETENTION_DAYS=30
FYT_AUTO_BACKUP_KEEP=7
FYT_LIBRARY_USER_QUOTA_BYTES=2147483648
FYT_NOTIFY_WEBHOOK_URL=
